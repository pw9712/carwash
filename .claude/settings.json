{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(python -m ruff:*)",
      "Bash(.venv/Scripts/python.exe -m ruff:*)",
      "Bash(.venv/bin/python -m ruff:*)",
      "Bash(mypy:*)",
      "Bash(python -m mypy:*)",
      "Bash(.venv/Scripts/python.exe -m mypy:*)",
      "Bash(.venv/bin/python -m mypy:*)",
      "Bash(carwash:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Edit(.venv/**)",
      "Write(.venv/**)"
    ]
  }
}
